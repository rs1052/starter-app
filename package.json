{
  "name": "void-vue-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "preview": "vp preview --host 127.0.0.1 --port 4174 --strictPort",
    "build": "vp build",
    "deploy": "vp run build && wrangler deploy --config dist/ssr/wrangler.json",
    "prepare:types": "void prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "vp run db:migrate:d1:local",
    "db:migrate:sqlite": "node scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset:sqlite": "node scripts/reset-database.ts",
    "db:migrate:d1:local": "vp run build && wrangler d1 migrations apply DB --config dist/ssr/wrangler.json --local --persist-to .void",
    "lint": "vp lint && eslint .",
    "lint:css": "stylelint \"resources/**/*.css\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "typecheck": "void prepare && vue-tsc --noEmit",
    "test": "vp test run --config vitest.config.ts",
    "test:browser": "vp build && node scripts/prepare-browser-db.ts && playwright test --grep-invert @a11y",
    "test:a11y": "vp build && node scripts/prepare-browser-db.ts && playwright test --grep @a11y",
    "test:worker": "vp run build && node scripts/smoke-worker.ts",
    "fallow": "fallow",
    "verify": "vp run prepare:types && vp run lint && vp run lint:css && vp run lint:md && vp run format:check && vp run typecheck && vp run test && vp run test:browser && vp run test:a11y && vp run fallow && vp run test:worker"
  },
  "dependencies": {
    "@better-auth/core": "1.7.6",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@void/vue": "1.2.0",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "void": "1.2.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "fallow": "3.31.0",
    "markdownlint-cli2": "0.23.3",
    "stylelint": "17.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@11.22.0"
}
