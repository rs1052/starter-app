{
  "name": "hono-dual-runtime-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --mode worker --host 127.0.0.1 --port 4174 --strictPort",
    "build": "vite build --mode client && vite build --mode worker",
    "deploy": "pnpm build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:migrate:d1:local": "wrangler d1 migrations apply hono-dual-runtime-starter --local",
    "lint": "eslint .",
    "lint:css": "stylelint \"resources/**/*.css\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "tsx scripts/prepare-browser-db.ts && playwright test --grep-invert @a11y",
    "test:a11y": "tsx scripts/prepare-browser-db.ts && playwright test --grep @a11y",
    "test:worker": "pnpm build && tsx scripts/smoke-worker.ts",
    "fallow": "fallow",
    "verify": "pnpm lint && pnpm lint:css && pnpm lint:md && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:browser && pnpm test:a11y && pnpm fallow && pnpm test:worker"
  },
  "dependencies": {
    "@alpinejs/csp": "3.17.4",
    "@better-auth/drizzle-adapter": "1.7.6",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "htmx.org": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20260930.2",
    "@eslint/js": "10.0.1",
    "@hono/vite-dev-server": "0.26.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "fallow": "3.31.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  }
}
